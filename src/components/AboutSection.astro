---
/**
 * Final About Us Section - Full Content
 * Simple native animations, mobile fixed, low-opacity full-cover visual.
 */
---

<section class="about-section" id="about">
  <div class="container">
    <!-- Section Heading -->
    <div class="about-header">
      <h2 class="section-title">ABOUT <span class="accent">TRIVERSE</span></h2>
      <p class="section-subtitle">
        Triverse is a high-intensity tech event where thinking matters more than building.
      </p>
    </div>

    <div class="bento-grid">
      <!-- Card 1: Main Status (The Singularity) -->
      <div class="bento-item item-hero">
        <div class="item-visual">
          <img src="/rb-hand.png" alt="" class="bg-image image-1" />
        </div>
        <div class="item-content">
          <span class="label">OPERATIONAL STATUS</span>
          <h2 class="title">THE SINGULARITY <br />IS APPROACHING</h2>
          <div class="loading-bar">
            <div class="fill"></div>
          </div>
          <p class="card-text">
            Across three distinct formats, participants break real products, 
            launch absurd-yet-believable future tech, and compete in strategy-driven 
            coding battles that reward judgment, risk-taking, and psychological play.
          </p>
        </div>
      </div>

      <!-- Card 2: The Philosophy -->
      <div class="bento-item item-philosophy">
        <div class="item-content">
          <h3>The Rules of Play</h3>
          <p>
            There are no templates, no rote hacks, and no safe answers — only 
            pressure, clarity, and sharp decision-making.
          </p>
        </div>
      </div>

      <!-- Card 3: Target Audience -->
      <div class="bento-item item-access">
        <div class="item-content">
          <div class="icon-box">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
             </svg>
          </div>
          <h3>Built for Challengers</h3>
          <p>
            Designed for people who question systems, challenge assumptions, 
            and can defend their ideas when it counts.
          </p>
        </div>
      </div>

      <!-- Card 4: Intensity Visual -->
      <div class="bento-item item-visual-card">
        <div class="item-visual">
          <img src="/Tri.png" alt="" class="bg-image image-2" />
        </div>
        <div class="item-content center">
          <div class="intensity-label">SYSTEMS OVERBUILD</div>
          <h3>THINK DEEPER. <br/>PLAY SMARTER.</h3>
        </div>
      </div>

      <!-- Card 5: Result (Ship Nothing) -->
      <div class="bento-item item-network">
        <div class="item-content horiz">
          <div class="tagline-box">
            <span class="label-small">OPERATIONAL GOAL</span>
            <p class="impact-text">Ship nothing — prove everything.</p>
          </div>
          <div class="avatar-stack">
            <div class="avatar">BT</div>
            <div class="avatar">JD</div>
            <div class="avatar">SK</div>
            <div class="avatar more">+42</div>
          </div>
        </div>
      </div>

      <!-- Full Paragraph Footer -->
      <div class="footer-statement">
        <p>
          Triverse is built for people who question systems, challenge assumptions, and can defend their ideas when it counts. 
          Think deeper. Play smarter. Ship nothing — prove everything.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base Style */
  .about-section {
    padding: 100px 24px;
    background-color: #050505;
    color: #ffffff;
    font-family: var(--font-sf-pro), -apple-system, system-ui, sans-serif;
    position: relative;
    z-index: 5;
    width: 100%;
    display: block !important;
    min-height: 500px;
    overflow: visible;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header */
  .about-header {
    text-align: center;
    margin-bottom: 60px;
    opacity: 0;
    animation: fadeInStep 0.8s ease forwards;
  }

  .section-title {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    margin-bottom: 1.5rem;
    line-height: 0.9;
  }

  .accent {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.5);
    max-width: 700px;
    margin: 0 auto;
    font-weight: 300;
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(180px, auto);
    gap: 16px;
  }

  .bento-item {
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    opacity: 0;
    animation: fadeInStep 0.8s ease forwards;
    transition: border-color 0.3s ease;
  }

  .bento-item:hover {
    border-color: rgba(147, 51, 234, 0.4);
  }

  /* Item Layouts */
  .item-hero { grid-column: span 2; grid-row: span 2; padding: 4rem; }
  .item-philosophy { grid-column: span 1; grid-row: span 1; }
  .item-access { background-color: #9333ea; }
  .item-visual-card { grid-column: span 1; grid-row: span 2; border-left: 2px solid #ec4899; }
  .item-network { grid-column: span 2; }

  /* Visuals */
  .item-visual { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .bg-image { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); filter: grayscale(1); opacity: 0.12; }
  .image-1 { width: 100%; height: 100%; object-fit: cover; }
  .image-2 { width: 50%; opacity: 0.08; }

  /* Content Styling */
  .item-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; }
  .center { justify-content: center; align-items: center; text-align: center; }
  
  .label { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.25rem; color: #ec4899; margin-bottom: 2rem; display: block; }
  .title { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; line-height: 1.1; margin-bottom: 2rem; }
  
  .loading-bar { width: 180px; height: 6px; background: rgba(255, 255, 255, 0.1); margin-bottom: 2rem; border-radius: 99px; overflow: hidden; }
  .fill { height: 100%; width: 38%; background: #9333ea; }
  
  .card-text { font-size: 1rem; color: rgba(255, 255, 255, 0.7); max-width: 500px; line-height: 1.6; }
  
  h3 { font-size: 1.6rem; font-weight: 800; margin-bottom: 1rem; letter-spacing: -0.02em; }
  p { font-size: 0.95rem; color: rgba(255, 255, 255, 0.6); line-height: 1.7; }
  
  .intensity-label { font-size: 0.7rem; font-weight: 950; letter-spacing: 0.1em; color: #ec4899; margin-bottom: 1rem; }

  .horiz { flex-direction: row; align-items: center; justify-content: space-between; }
  .impact-text { font-size: 1.4rem; font-weight: 800; color: #fff; line-height: 1; }

  .avatar-stack { display: flex; align-items: center; }
  .avatar {
    width: 44px; height: 44px; border-radius: 8px; background: #1a1a1a;
    border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center;
    justify-content: center; font-size: 0.75rem; font-weight: 700; margin-right: -10px;
  }
  .avatar.more { background: #e9d5ff; color: #000; margin-right: 0; }
  .label-small { color: #ec4899; font-size: 0.7rem; font-weight: 900; letter-spacing: 0.15em; margin-bottom: 0.5rem; display: block; }

  .footer-statement {
    grid-column: span 3;
    padding: 60px 0;
    text-align: center;
    margin-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    opacity: 0;
    animation: fadeInStep 1.2s ease forwards;
    animation-delay: 0.6s;
  }
  .footer-statement p {
    font-size: 1.35rem;
    max-width: 900px;
    margin: 0 auto;
    font-weight: 300;
    line-height: 1.8;
  }

  /* Simple Animation */
  @keyframes fadeInStep {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .bento-item:nth-child(2) { animation-delay: 0.2s; }
  .bento-item:nth-child(3) { animation-delay: 0.3s; }
  .bento-item:nth-child(4) { animation-delay: 0.4s; }
  .bento-item:nth-child(5) { animation-delay: 0.5s; }

  /* RESPONSIVE (CRITICAL) */
  @media (max-width: 1024px) {
    .bento-grid { grid-template-columns: 1fr 1fr; }
    .item-hero { grid-column: span 2; }
    .item-visual-card { grid-row: span 1; }
    .footer-statement { grid-column: span 2; }
  }

  @media (max-width: 768px) {
    .about-section {
      padding: 60px 20px;
    }
    .bento-grid {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .bento-item {
      width: 100% !important;
      min-height: auto;
      padding: 2.5rem;
    }
    .item-hero { padding: 2.5rem; }
    .footer-statement p { font-size: 1.1rem; }
    .horiz { flex-direction: column; align-items: flex-start; gap: 2rem; }
  }
</style>
