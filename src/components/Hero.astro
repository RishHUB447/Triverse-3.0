---
import { Image } from "astro:assets";
import arcImage from "../images/arc.png";
import triLogo from "../images/Tri.png";
---

<div
    class="hero-container relative overflow-hidden bg-[#050505] flex flex-col items-center justify-between"
>
    <!-- Background Stars & Glows -->
    <div class="stars absolute inset-0 z-0"></div>
    <div class="hero-glow absolute rounded-full pointer-events-none z-0"></div>

    <!-- ===== UPPER CONTENT BLOCK ===== -->
    <div
        class="hero-top-block z-10 flex flex-col items-center justify-center flex-1 w-full text-center"
    >
        <p
            class="hero-subtitle text-white/50 uppercase font-sf-pro opacity-0 will-change-transform w-full"
        >
            The Academic Singularity
        </p>

        <div
            class="hero-title-wrapper flex items-center justify-center w-full max-w-[100vw]"
        >
            <div class="hero-logo-box">
                <Image
                    src={triLogo}
                    alt="Triverse Logo"
                    class="hero-title-img h-auto object-contain opacity-0 will-change-transform"
                />
            </div>
            <h1
                class="hero-title-text font-centauri bg-clip-text text-transparent bg-gradient-to-r from-white via-[#f0e6ff] to-[#dcb8ff] m-0 leading-none opacity-0 will-change-[filter,opacity,transform]"
            >
                TRIVERSE
            </h1>
            <div class="hero-logo-box-ghost"></div>
        </div>
    </div>

    <!-- ===== BOTTOM STACK: Timer → Button ===== -->
    <div
        class="hero-bottom-stack relative w-full flex flex-col items-center z-20"
    >
        <!-- Countdown Timer -->
        <div class="hero-timer-grid grid grid-cols-4 z-30">
            <div
                class="hero-timer glass-timer-box opacity-0 will-change-transform"
            >
                <span class="timer-num" id="days">00</span>
                <span class="timer-label">DAYS</span>
            </div>
            <div
                class="hero-timer glass-timer-box opacity-0 will-change-transform"
            >
                <span class="timer-num" id="hours">00</span>
                <span class="timer-label">HOURS</span>
            </div>
            <div
                class="hero-timer glass-timer-box opacity-0 will-change-transform"
            >
                <span class="timer-num" id="minutes">00</span>
                <span class="timer-label">MINUTES</span>
            </div>
            <div
                class="hero-timer glass-timer-box opacity-0 will-change-transform"
            >
                <span class="timer-num" id="seconds">00</span>
                <span class="timer-label">SECONDS</span>
            </div>
        </div>

        <!-- Register Button -->
        <div class="hero-btn z-30 opacity-0">
            <a href="/events" class="register-btn">REGISTER NOW</a>
        </div>
    </div>

    <!-- Arc wrapper (BACKGROUND) -->
    <div class="hero-arc-wrapper pointer-events-none opacity-0">
        <div
            class="hero-arc-glow absolute bottom-0 w-full h-full bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-[#8a2be2]/55 via-[#8a2be2]/20 to-transparent z-0"
        >
        </div>
        <Image
            src={arcImage}
            alt="Planet Horizon"
            class="hero-arc-img absolute bottom-0 max-w-none h-auto object-cover object-top z-10"
        />
    </div>
</div>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const checkGsap = setInterval(() => {
            if (window.gsap) {
                clearInterval(checkGsap);
                initHeroAnimations();
            }
        }, 100);

        function initHeroAnimations() {
            const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

            tl.fromTo(
                ".hero-arc-wrapper",
                { opacity: 0, y: 80 },
                { opacity: 1, y: 0, duration: 2.5, ease: "power2.out" },
                0,
            )
                .fromTo(
                    ".hero-brand",
                    { opacity: 0, x: -30 },
                    { opacity: 1, x: 0, duration: 1.2 },
                    0.2,
                )
                .fromTo(
                    ".hero-title-img",
                    { opacity: 0, scale: 0, rotation: -180 },
                    {
                        opacity: 1,
                        scale: 1,
                        rotation: 0,
                        duration: 1.5,
                        ease: "back.out(1.2)",
                    },
                    0.5,
                )
                .fromTo(
                    ".hero-title-text",
                    { opacity: 0, filter: "blur(25px)", y: 40, scale: 0.9 },
                    {
                        opacity: 1,
                        filter: "blur(0px)",
                        y: 0,
                        scale: 1,
                        duration: 1.8,
                        ease: "expo.out",
                    },
                    0.6,
                )
                .fromTo(
                    ".hero-subtitle",
                    { opacity: 0, letterSpacing: "1em", y: -20 },
                    {
                        opacity: 1,
                        letterSpacing: window.innerWidth < 768 ? "0.3em" : "0.55em",
                        y: 0,
                        duration: 1.5,
                        ease: "power4.out",
                    },
                    0.8,
                )
                .fromTo(
                    ".hero-desc",
                    { opacity: 0, y: 20 },
                    { opacity: 1, y: 0, duration: 1.2 },
                    1.0,
                )
                .fromTo(
                    ".hero-timer",
                    { opacity: 0, y: 60, rotationX: 90, scale: 0.8 },
                    {
                        opacity: 1,
                        y: 0,
                        rotationX: 0,
                        scale: 1,
                        duration: 1.2,
                        stagger: 0.1,
                        ease: "back.out(1.4)",
                        transformOrigin: "center top",
                    },
                    1.1,
                )
                .fromTo(
                    ".hero-btn",
                    { opacity: 0, y: 30, scale: 0.6 },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "elastic.out(1, 0.4)",
                    },
                    1.5,
                );
        }

        // Countdown to April 16, 2026 00:00 IST (UTC+5:30 = UTC 18:30 on Apr 15)
        const targetDate = new Date("2026-04-15T18:30:00Z");

        function updateElement(id, value) {
            const el = document.getElementById(id);
            if (el && el.textContent !== value) {
                el.textContent = value;
                if (window.gsap) {
                    gsap.fromTo(
                        el,
                        {
                            scale: 1.2,
                            color: "#dcb8ff",
                            textShadow: "0 0 20px rgba(138,43,226,0.8)",
                        },
                        {
                            scale: 1,
                            color: "#ffffff",
                            textShadow: "0 0 0px rgba(138,43,226,0)",
                            duration: 0.6,
                            ease: "power2.out",
                            overwrite: "auto",
                        },
                    );
                }
            }
        }

        function updateTimer() {
            const now = new Date();
            const difference = targetDate.getTime() - now.getTime();
            if (difference <= 0) {
                ["days", "hours", "minutes", "seconds"].forEach((id) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = "00";
                });
                return;
            }
            const days = Math.floor(difference / (1000 * 60 * 60 * 24));
            const hours = Math.floor(
                (difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
            );
            const minutes = Math.floor(
                (difference % (1000 * 60 * 60)) / (1000 * 60),
            );
            const seconds = Math.floor((difference % (1000 * 60)) / 1000);
            updateElement("days", days.toString().padStart(2, "0"));
            updateElement("hours", hours.toString().padStart(2, "0"));
            updateElement("minutes", minutes.toString().padStart(2, "0"));
            updateElement("seconds", seconds.toString().padStart(2, "0"));
        }

        setInterval(updateTimer, 1000);
        updateTimer();
    });
</script>

<style>
    /* ─── PURE CSS LAYOUT (Bypassing Tailwind JIT) ─── */
    .hero-container {
        width: 100%;
        height: 100vh;
    }

    /* Glows & Environment */
    .hero-glow {
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 800px;
        height: 800px;
        background-color: rgba(138, 43, 226, 0.15);
        filter: blur(140px);
    }
    .hero-arc-glow {
        filter: blur(60px);
    }

    /* Top Content Block */
    .hero-top-block {
        padding: 60px 16px 20px;
    }
    @media (min-width: 640px) {
        .hero-top-block {
            padding: 100px 24px 28px;
        }
    }
    @media (min-width: 768px) {
        .hero-top-block {
            padding: 108px 24px 28px;
        }
    }

    .hero-subtitle {
        font-size: 0.5rem;
        letter-spacing: 0.25em;
        margin-bottom: 1.25rem;
    }
    @media (min-width: 640px) {
        .hero-subtitle {
            font-size: 0.65rem;
            letter-spacing: 0.55em;
            margin-bottom: 2rem;
        }
    }
    @media (min-width: 768px) {
        .hero-subtitle {
            font-size: 0.75rem;
            margin-bottom: 2.5rem;
        }
    }

    .hero-title-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-bottom: 1rem;
        gap: 0.5rem;
    }
    @media (min-width: 768px) {
        .hero-title-wrapper {
            flex-direction: row;
            margin-bottom: 2rem;
            gap: 1.5rem;
        }
    }

    .hero-logo-box {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .hero-logo-box-ghost {
        display: none !important;
    }
    @media (min-width: 768px) {
        .hero-logo-box {
            width: auto;
        }
    }

    .hero-title-img {
        width: 3rem;
    }
    @media (min-width: 640px) {
        .hero-title-img {
            width: 3.5rem;
        }
    }
    @media (min-width: 768px) {
        .hero-title-img {
            width: 5.5rem;
        }
    }
    @media (min-width: 1024px) {
        .hero-title-img {
            width: 6.5rem;
        }
    }

    .hero-title-text {
        font-size: 9.5vw;
        letter-spacing: 0.05em;
        max-width: 95vw;
        will-change: filter, opacity, transform;
    }
    @media (min-width: 640px) {
        .hero-title-text {
            font-size: 4rem;
            letter-spacing: 0.1em;
        }
    }
    @media (min-width: 768px) {
        .hero-title-text {
            font-size: 5rem;
        }
    }
    @media (min-width: 1024px) {
        .hero-title-text {
            font-size: 7rem;
        }
    }

    .hero-desc {
        font-size: 0.75rem;
        max-width: 85vw;
        padding: 0 4px;
        margin: 0 auto;
        line-height: 1.6;
    }
    @media (min-width: 640px) {
        .hero-desc {
            font-size: 0.88rem;
            max-width: 28rem;
        }
    }
    @media (min-width: 768px) {
        .hero-desc {
            font-size: 0.875rem;
            max-width: 36rem;
        }
    }

    /* Bottom Stack */
    .hero-bottom-stack {
        padding-top: 0.5rem;
        padding-bottom: 1.5rem;
    }
    @media (min-width: 768px) {
        .hero-bottom-stack {
            padding-top: 1rem;
            padding-bottom: 2.75rem;
        }
    }

    .hero-timer-grid {
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        padding: 0 0.5rem;
    }
    @media (min-width: 380px) {
        .hero-timer-grid {
            gap: 0.625rem;
            margin-bottom: 1.5rem;
            padding: 0 1rem;
        }
    }
    @media (min-width: 640px) {
        .hero-timer-grid {
            gap: 1rem;
            margin-bottom: 2rem;
        }
    }
    @media (min-width: 768px) {
        .hero-timer-grid {
            gap: 1.5rem;
            margin-bottom: 3rem;
        }
    }
    @media (min-width: 1024px) {
        .hero-timer-grid {
            gap: 2rem;
        }
    }

    .hero-btn {
        margin-bottom: 0;
    }

    .hero-arc-wrapper {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 50vw;
        max-height: 400px;
        z-index: 5; /* behind timer grid/button z-20 */
    }
    @media (min-width: 640px) {
        .hero-arc-wrapper {
            height: 45vw;
            max-height: 500px;
        }
    }
    @media (min-width: 768px) {
        .hero-arc-wrapper {
            height: 40vw;
            max-height: 550px;
        }
    }

    .hero-arc-img {
        left: 50%;
        transform: translateX(-50%) translateY(15%);
        width: 160%;
        min-width: 800px; /* Forces huge height curvature on narrow screens */
    }
    @media (min-width: 640px) {
        .hero-arc-img {
            width: 140%;
            transform: translateX(-50%) translateY(10%);
        }
    }
    @media (min-width: 768px) {
        .hero-arc-img {
            width: 125%;
            transform: translateX(-50%) translateY(5%);
        }
    }

    /* Typography Additions */
    .font-centauri {
        font-family: var(--font-centauri, sans-serif);
    }
    .font-sf-pro {
        font-family: var(--font-sf-pro, sans-serif);
    }

    /* ─── Glass Timer Box ─────────────────────────────── */
    .glass-timer-box {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        /* Mobile default (fitting 320px width) */
        width: 4rem;
        height: 5rem;
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 0.75rem;
        padding: 0.4rem;
        overflow: hidden;
        transition:
            transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
            box-shadow 0.4s ease;
    }

    @media (min-width: 380px) {
        .glass-timer-box {
            width: 4.8rem;
            height: 5.8rem;
        }
    }

    @media (min-width: 640px) {
        .glass-timer-box {
            width: 5.5rem;
            height: 6.5rem;
            border-radius: 1rem;
        }
    }

    @media (min-width: 768px) {
        .glass-timer-box {
            width: 7rem;
            height: 8rem;
            padding: 1rem;
        }
    }

    .glass-timer-box::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.3),
            transparent
        );
        opacity: 0.6;
    }
    .glass-timer-box::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(138, 43, 226, 0.9),
            transparent
        );
        box-shadow: 0 -5px 20px rgba(138, 43, 226, 0.6);
    }

    .glass-timer-box:hover {
        transform: translateY(-8px) scale(1.03);
        box-shadow: 0 20px 40px -10px rgba(138, 43, 226, 0.5);
        border-color: rgba(138, 43, 226, 0.5);
        background: rgba(255, 255, 255, 0.06);
    }

    /* ─── Timer Numbers ───────────────────────────────── */
    .timer-num {
        font-family: var(--font-sf-pro, sans-serif);
        font-weight: 800;
        font-size: 1.6rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 0.2rem;
        transform-origin: bottom center;
    }

    @media (min-width: 380px) {
        .timer-num {
            font-size: 1.85rem;
        }
    }
    @media (min-width: 640px) {
        .timer-num {
            font-size: 2.25rem;
        }
    }
    @media (min-width: 768px) {
        .timer-num {
            font-size: 3.5rem;
            margin-bottom: 0.25rem;
        }
    }

    .timer-label {
        font-family: var(--font-sf-pro, sans-serif);
        font-size: 0.38rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        color: rgba(255, 255, 255, 0.5);
        text-transform: uppercase;
    }

    @media (min-width: 380px) {
        .timer-label {
            font-size: 0.42rem;
        }
    }
    @media (min-width: 640px) {
        .timer-label {
            font-size: 0.48rem;
            letter-spacing: 0.2em;
        }
    }
    @media (min-width: 768px) {
        .timer-label {
            font-size: 0.65rem;
            letter-spacing: 0.25em;
        }
    }

    /* ─── Register Button ─────────────────────────────── */
    .register-btn {
        position: relative;
        padding: 1rem 2.6rem;
        font-family: var(--font-sf-pro, sans-serif);
        font-weight: 800;
        font-size: 0.82rem;
        letter-spacing: 0.18em;
        color: #ffffff;
        background: rgba(138, 43, 226, 0.18);
        border: 1px solid rgba(138, 43, 226, 0.65);
        border-radius: 9999px;
        cursor: pointer;
        outline: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        text-transform: uppercase;
        box-shadow:
            0 0 28px rgba(138, 43, 226, 0.35),
            inset 0 0 16px rgba(138, 43, 226, 0.2);
        white-space: nowrap;
    }

    @media (min-width: 768px) {
        .register-btn {
            padding: 1.1rem 3.8rem;
            font-size: 1rem;
        }
    }

    .register-btn::before {
        content: "";
        position: absolute;
        inset: -2px;
        border-radius: 9999px;
        background: linear-gradient(
            45deg,
            rgba(138, 43, 226, 1),
            rgba(255, 174, 220, 0.7),
            rgba(138, 43, 226, 1)
        );
        z-index: -1;
        opacity: 0;
        transition: opacity 0.4s ease;
        filter: blur(12px);
    }

    .register-btn:hover {
        background: rgba(138, 43, 226, 0.38);
        border-color: rgba(255, 174, 220, 1);
        transform: scale(1.05);
        box-shadow:
            0 0 44px rgba(138, 43, 226, 0.75),
            inset 0 0 22px rgba(138, 43, 226, 0.5);
    }

    .register-btn:hover::before {
        opacity: 1;
        animation: rotateGlow 2.5s linear infinite;
    }

    @keyframes rotateGlow {
        0% {
            filter: hue-rotate(0deg) blur(12px);
        }
        100% {
            filter: hue-rotate(360deg) blur(12px);
        }
    }

    /* ─── Stars ───────────────────────────────────────── */
    .stars {
        background-image:
            radial-gradient(
                1px 1px at 15% 15%,
                rgba(255, 255, 255, 0.8) 50%,
                transparent 100%
            ),
            radial-gradient(
                1px 1px at 35% 25%,
                rgba(255, 255, 255, 0.8) 50%,
                transparent 100%
            ),
            radial-gradient(
                1px 1px at 55% 45%,
                rgba(255, 255, 255, 0.8) 50%,
                transparent 100%
            ),
            radial-gradient(
                1px 1px at 75% 65%,
                rgba(255, 255, 255, 0.8) 50%,
                transparent 100%
            ),
            radial-gradient(
                1px 1px at 85% 15%,
                rgba(255, 255, 255, 0.8) 50%,
                transparent 100%
            ),
            radial-gradient(
                2px 2px at 10% 80%,
                rgba(255, 255, 255, 0.7) 50%,
                transparent 100%
            ),
            radial-gradient(
                1px 1px at 60% 85%,
                rgba(255, 255, 255, 0.8) 50%,
                transparent 100%
            ),
            radial-gradient(
                2px 2px at 40% 40%,
                rgba(255, 255, 255, 0.6) 50%,
                transparent 100%
            );
        background-size: 550px 550px;
        opacity: 0.35;
        animation: twinkle 8s infinite alternate ease-in-out;
    }

    @keyframes twinkle {
        0% {
            opacity: 0.25;
            transform: scale(1);
        }
        100% {
            opacity: 0.6;
            transform: scale(1.02);
        }
    }

    /* ─── Prevent content overflow on tiny phones ─────── */
    @media (max-height: 700px) {
        .hero-container {
            height: auto;
            min-height: 100svh;
        }
    }
</style>
