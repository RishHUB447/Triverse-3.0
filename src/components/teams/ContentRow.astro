---
interface Props {
  name: string;
  handle: string;
  role: string;
  roleColor: string;
  image: string;
}

const { name, handle, role, roleColor, image } = Astro.props;
---

<div class="content-row">
  <!-- Column 1: Profile (Square image) -->
  <div class="column col-profile">
    <div class="image-wrapper">
      <img src={image} alt={name} class="profile-img" />
    </div>
  </div>

  <!-- Column 2: Identity -->
  <div class="column col-identity">
    <h3 class="name">{name}</h3>
    <p class="handle">{handle}</p>
  </div>

  <!-- Column 3: Position -->
  <div class="column col-position">
    <div class="role-badge" style={`color: ${roleColor}; border-color: rgba(255,255,255,0.1);`}>
      {role}
    </div>
  </div>
</div>

<style>
  .handle {
    font-family: var(--font-sf-pro), sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: 0.85rem;
    color: #888;
    margin: 0;
  }

  /* --- Column 3: Position --- */
  .col-position {
    display: flex;
    justify-content: flex-start; /* Or center based on preference, mockup looks left aligned inside column */
  }

  .role-badge {
    font-family: var(--font-sf-pro), sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.8rem;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .content-row {
      /* On mobile horizontal scroll, give the row a fixed minimum width so it doesn't squish */
      width: 700px; 
      padding: 2rem 1rem;
    }
  }
</style>
