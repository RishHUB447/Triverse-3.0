---
interface Props {
  name: string;
  role: string;
  iconType?: string;
  accentColor: string;
  offsetColor: string;
  image: string;
  hasImage: boolean;
  index: number;
}

const { name, role, iconType = "grid", accentColor, offsetColor, image, hasImage, index } = Astro.props;

const rot = index % 2 === 0 ? '-3deg' : '3deg';
const hoverRot = index % 2 === 0 ? '-5deg' : '5deg';
const offsetX = index % 2 === 0 ? '-12px' : '12px';
const hoverOffsetX = index % 2 === 0 ? '-16px' : '16px';

// Icons dictionary
const icons: Record<string, string> = {
  nodes: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="m3 12 18 0"/><circle cx="12" cy="12" r="3"/><circle cx="12" cy="3" r="2"/><circle cx="12" cy="21" r="2"/><circle cx="3" cy="12" r="2"/><circle cx="21" cy="12" r="2"/></svg>`,
  grid: `<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="4" cy="4" r="2"/><circle cx="12" cy="4" r="2"/><circle cx="20" cy="4" r="2"/><circle cx="4" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="20" cy="12" r="2"/><circle cx="4" cy="20" r="2"/><circle cx="12" cy="20" r="2"/><circle cx="20" cy="20" r="2"/></svg>`,
  sparkles: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>`,
  cube: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16-9 5-9-5V8l9-5 9 5Z"/><path d="m3.27 6.96 8.73 5.05 8.73-5.05"/><path d="M12 22V12"/></svg>`,
  layout: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
};

const svgContent = icons[iconType] || icons.grid;
---

<div class="design-card-wrapper">
  <!-- Offset Background -->
  <div class="offset-bg" style={`background-color: ${offsetColor}; --rot: ${rot}; --h-rot: ${hoverRot}; --x: ${offsetX}; --h-x: ${hoverOffsetX};`}></div>
  
  <!-- Main Card -->
  <div class="main-card">
    {hasImage ? (
      <div class="image-container">
        <img src={image} alt={name} class="photo" />
      </div>
    ) : (
      <div class="icon-container">
        <div class="icon-wrapper" style={`color: ${accentColor};`} set:html={svgContent}></div>
        <p class="role-text">{role}</p>
      </div>
    )}
  </div>

  <!-- Overlapping Name -->
  <h3 class="overlapping-name" style={`color: ${accentColor};`}>{name}</h3>
</div>

<style>
  .design-card-wrapper {
    position: relative;
    width: 240px;
    height: 350px;
    flex-shrink: 1; /* Allow shrinking to fit on one row */
    min-width: 200px; /* Safety bound */
    margin: 1rem; 
    transition: transform 0.4s ease;
  }

  .design-card-wrapper:hover {
    transform: translateY(-8px) scale(1.02);
  }

  /* Solid colored layer behind the card - more subtle */
  .offset-bg {
    position: absolute;
    inset: 0;
    transform: rotate(var(--rot)) translate(var(--x), 8px);
    z-index: 1;
    opacity: 0.5; /* Made it more subtle */
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .design-card-wrapper:hover .offset-bg {
    transform: rotate(var(--h-rot)) translate(var(--h-x), 12px);
    opacity: 0.8;
  }

  /* The actual card */
  .main-card {
    position: absolute;
    inset: 0;
    background-color: #1a1a1a;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  /* Image Mode */
  .image-container {
    width: 100%;
    height: 100%;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9) contrast(1.1);
    transition: transform 0.6s ease;
  }

  .design-card-wrapper:hover .photo {
    transform: scale(1.05);
  }

  /* Icon Mode */
  .icon-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .icon-wrapper {
    width: 48px;
    height: 48px;
  }

  .icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
  }

  .role-text {
    font-family: var(--font-sf-pro), sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: #fff;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
  }

  /* The big name sticking out of the bottom right corner */
  .overlapping-name {
    position: absolute;
    bottom: -15px;
    right: -12px; /* Less aggressive overshoot to prevent clipping */
    z-index: 10;
    font-family: var(--font-sf-pro), sans-serif;
    font-weight: 900;
    font-size: 2rem; /* Slighly smaller */
    margin: 0;
    letter-spacing: -0.02em;
    text-shadow: 0 4px 10px rgba(0,0,0,0.4);
    pointer-events: none; /* So it doesn't interfere with card hovering */
  }

  @media (max-width: 768px) {
    .design-card-wrapper {
      width: 240px;
      height: 350px;
      margin: 15px;
    }
    .overlapping-name {
      font-size: 2.2rem;
      right: -15px;
    }
  }
</style>
