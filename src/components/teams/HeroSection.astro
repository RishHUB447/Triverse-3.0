---

---

<section class="hero-section">
    <div class="container">
        <div class="hero-top">
            <span class="label">THE COLLECTIVE</span>
        </div>

        <div class="hero-main">
            <div class="title-group">
                <h1 class="title-architects">ARCHITECTS</h1>
                <h1 class="title-triverse">
                    OF <span class="gradient-text">TRIVERSE</span>
                </h1>
            </div>

            <div class="hero-description">
                <p>
                    A high-velocity production squad specializing in cinematic
                    social narratives and aggressive brand identities.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        padding: 4rem 2rem 0;
        position: relative;
        min-height: 80vh; /* Reduced as ticker is now separate */
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 1;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
    }

    .hero-top {
        margin-bottom: 1rem;
    }

    .label {
        color: #00f5d4;
        font-size: 0.85rem;
        letter-spacing: 0.3rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .hero-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 4rem;
    }

    .title-group h1 {
        font-size: clamp(3.5rem, 12vw, 10rem);
        line-height: 0.85;
        margin: 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        text-transform: uppercase;
    }

    .title-architects {
        color: white;
    }

    .title-triverse {
        color: white;
    }

    .gradient-text {
        background: linear-gradient(
            180deg,
            #ffffff 0%,
            #d8b4fe 50%,
            #a855f7 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
    }

    .hero-description {
        max-width: 320px;
        margin-bottom: 2rem;
    }

    .hero-description p {
        font-size: 1.15rem;
        line-height: 1.4;
        color: #cbd5e0;
        font-weight: 300;
        margin: 0;
        opacity: 0.8;
    }

    @media (max-width: 1024px) {
        .hero-main {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-description {
            max-width: 100%;
            margin-top: 2rem;
        }

        .title-group h1 {
            font-size: 15vw;
        }
    }

    @media (max-width: 768px) {
        .hero-section {
            padding-top: 8rem;
        }
    }
</style>
