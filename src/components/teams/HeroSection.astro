---

---

<section class="hero-section">
    <div class="container">
        <div class="hero-top">
            <span class="label">THE COLLECTIVE</span>
        </div>

        <div class="hero-main">
            <div class="title-group">
                <h1 class="title-architects">ARCHITECTS</h1>
                <h1 class="title-triverse">
                    <span class="split-target">OF</span> <span class="gradient-text">TRIVERSE</span>
                </h1>
            </div>

            <div class="hero-description">
                <p>
                    A high-velocity production squad specializing in cinematic
                    social narratives and aggressive brand identities.
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        padding: 4rem 2rem 0;
        position: relative;
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 1;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
    }

    .hero-top {
        margin-bottom: 1rem;
    }

    .label {
        color: #00f5d4;
        font-size: 0.85rem;
        letter-spacing: 0.3rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .hero-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 4rem;
    }

    .title-group h1 {
        line-height: 0.85;
        margin: 0;
        font-weight: 900;
        letter-spacing: -0.04em;
        text-transform: uppercase;
    }

    .title-architects {
        font-size: clamp(3.5rem, 12vw, 10rem);
        color: white;
    }

    .title-triverse {
        color: white;
        font-size: clamp(2.5rem, 8.5vw, 7.5rem); /* Smaller base size for Centauri */
        margin-top: -0.5rem;
    }

    .gradient-text {
        font-family: var(--font-centauri);
        background: linear-gradient(
            180deg,
            #ffffff 0%,
            #d8b4fe 50%,
            #a855f7 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
        /* Ensure it doesn't scale wider than the container */
        max-width: 100%;
        overflow-wrap: break-word;
    }

    .hero-description {
        max-width: 320px;
        margin-bottom: 2rem;
    }

    .hero-description p {
        font-size: 1.15rem;
        line-height: 1.4;
        color: #cbd5e0;
        font-weight: 300;
        margin: 0;
        opacity: 0.8;
    }

    @media (max-width: 1024px) {
        .hero-main {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-description {
            max-width: 100%;
            margin-top: 2rem;
        }

        .title-architects {
            font-size: 15vw;
        }

        .title-triverse {
            font-size: 11vw; /* Visually balanced with Architects on tablet */
        }
    }

    @media (max-width: 768px) {
        .hero-section {
            padding-top: 8rem;
        }

        .title-triverse {
            font-size: 10vw; /* Further reduction for mobile safety */
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const checkGsap = setInterval(() => {
            if (window.gsap) {
                clearInterval(checkGsap);
                
                // Only split non-gradient text into characters
                // IMPORTANT: .gradient-text is excluded because background-clip:text
                // breaks when child spans are injected (children inherit transparent fill
                // but NOT the gradient background, making text invisible)
                document.querySelectorAll('.title-architects, .split-target').forEach(el => {
                    if (el.classList.contains('gradient-text')) return; // Skip gradient elements
                    const text = el.innerText;
                    el.innerHTML = text.split('').map(char => 
                        char === ' ' ? '&nbsp;' : `<span class="char" style="display:inline-block; opacity:0; transform:scale(0.5); filter:blur(10px);">${char}</span>`
                    ).join('');
                });
                
                const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
                
                // Initial state for non-split elements
                gsap.set([".label", ".hero-description p"], {
                    y: 40,
                    opacity: 0
                });

                // Initial state for the gradient word (animate as whole block)
                gsap.set(".gradient-text", {
                    opacity: 0,
                    scale: 0.6,
                    filter: "blur(12px)"
                });

                // Animate sequence
                tl.to(".label", {
                    y: 0,
                    opacity: 1,
                    duration: 0.8,
                    delay: 0.2
                })
                .to(".char", {
                    scale: 1,
                    filter: "blur(0px)",
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.04,
                    ease: "back.out(1.5)"
                }, "-=0.4")
                .to(".gradient-text", {
                    opacity: 1,
                    scale: 1,
                    filter: "blur(0px)",
                    duration: 1,
                    ease: "power4.out"
                }, "-=0.5")
                .to(".hero-description p", {
                    y: 0,
                    opacity: 1,
                    duration: 0.8
                }, "-=0.4");
            }
        }, 100);
    });
</script>
