---
import LeadCard from "./LeadCard.astro";
import leadsData from "../../data/leads.json";
---

<section class="leads-section">
    <div class="container">
        <div class="section-header">
            <span class="label">CORE LEADERSHIP</span>
            <h2 class="section-title">THE LEADS</h2>
        </div>
        
        <div class="leads-grid">
            {leadsData.map((lead, index) => (
                <LeadCard 
                    name={lead.name}
                    role={lead.role}
                    image={lead.image}
                    index={index}
                />
            ))}
        </div>
    </div>
</section>

<style>
    .leads-section {
        padding: 4rem 2rem 10rem;
        background-color: #000;
        position: relative;
        z-index: 10;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .section-header {
        margin-bottom: 5rem;
        text-align: left;
    }

    .label {
        color: #00f5d4;
        font-size: 0.85rem;
        letter-spacing: 0.3rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 1rem;
        display: block;
    }

    .section-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 900;
        color: white;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        line-height: 1;
    }

    .leads-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr); /* All 6 on one line for desktop */
        gap: 0.75rem; /* Even tighter for 6-column layout */
        align-items: start;
    }

    @media (max-width: 1280px) {
        .leads-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }
    }

    @media (max-width: 768px) {
        .leads-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
    }

    @media (max-width: 480px) {
        .leads-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>
