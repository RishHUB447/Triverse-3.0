---
interface Props {
  id: string;
  name: string;
  role: string;
  color: string;
  image: string;
}

const { id, name, role, color, image } = Astro.props;
---

<div class="operational-card">
  <!-- Image Background Layer -->
  <div class="image-layer">
    <img src={image} alt={name} class="profile-image" />
    <div class="overlay-gradient"></div>
  </div>

  <div class="card-content">
    <div class="card-header">
      <span class="index">{id}</span>
    </div>

    <div class="card-footer">
      <h3 class="name">{name}</h3>
      <p class="role">{role}</p>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&family=JetBrains+Mono:wght@700&display=swap');

  .operational-card {
    position: relative;
    background-color: #000;
    border: 1px solid rgba(255, 255, 255, 0.2);
    aspect-ratio: 3 / 4; /* Reduced height portrait ratio */
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1), border-color 0.4s ease;
  }

  .operational-card:hover {
    transform: translateY(-8px);
    border-color: #fff;
  }

  /* Image Layer */
  .image-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.1);
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .operational-card:hover .profile-image {
    transform: scale(1.08);
  }

  .overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0) 30%,
      rgba(0, 0, 0, 0.5) 60%,
      rgba(0, 0, 0, 0.95) 100%
    );
    z-index: 2;
  }

  /* Content Overlay */
  .card-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1.5rem 2rem;
    box-sizing: border-box;
  }

  .card-header {
    display: flex;
    justify-content: flex-end;
  }

  .index {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #fff;
    opacity: 0.8;
    letter-spacing: 0.1em;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.25rem; /* Better spacing for legibility */
  }

  .name {
    font-family: var(--font-sf-pro), sans-serif;
    font-weight: 900;
    font-size: 1.15rem; /* Slightly larger name */
    color: #fff;
    margin: 0;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .role {
    font-family: 'Playfair Display', serif;
    font-variant: small-caps;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    letter-spacing: 0.08em;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  @media (max-width: 768px) {
    .card-content {
      padding: 1.25rem 1.25rem 2rem;
    }
    .name {
      font-size: 1rem;
    }
  }

  @media (max-width: 380px) {
    .name {
      font-size: 0.95rem;
    }
  }
</style>
