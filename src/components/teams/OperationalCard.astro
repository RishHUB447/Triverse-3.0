---
interface Props {
  id: string;
  name: string;
  role: string;
  color: string;
  image: string;
}

const { id, name, role, color, image } = Astro.props;
---

<div class="operational-card">
  <!-- Image Background Layer -->
  <div class="image-layer">
    <img src={image} alt={name} class="profile-image" />
    <div class="overlay-gradient"></div>
  </div>

  <div class="card-content">
    <div class="card-header">
      <span class="index">{id}</span>
    </div>

    <div class="card-footer">
      <h3 class="name">{name}</h3>
      <p class="role">{role}</p>
    </div>
  </div>
</div>

<style>
  .index {
    font-family: var(--font-sf-pro), sans-serif;
    font-size: 0.75rem;
    color: #fff;
    opacity: 0.8;
    letter-spacing: 0.1em;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .card-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.25rem; /* Better spacing for legibility */
  }

  .name {
    font-family: var(--font-sf-pro), sans-serif;
    font-weight: 900;
    font-size: 1.15rem; /* Slightly larger name */
    color: #fff;
    margin: 0;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8);
  }

  .role {
    font-family: var(--font-sf-pro), sans-serif;
    font-variant: small-caps;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    letter-spacing: 0.08em;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  @media (max-width: 768px) {
    .card-content {
      padding: 1.25rem 1.25rem 2rem;
    }
    .name {
      font-size: 1rem;
    }
  }

  @media (max-width: 380px) {
    .name {
      font-size: 0.95rem;
    }
  }
</style>
