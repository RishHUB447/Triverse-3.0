---
import MultimediaCard from "./MultimediaCard.astro";
import socialMediaData from "../../data/socialmedia.json";
---

<section class="socialmedia-section">
    <div class="container">
        <div class="section-layout">
            <!-- Left Branding -->
            <div class="branding">
                <h2 class="title">
                    <span class="white" data-aos="fade-down" data-aos-duration="600" data-aos-delay="200">TEAM</span>
                    <span class="pink" data-aos="fade-down" data-aos-delay="400" data-aos-duration="800">SOCIAL</span>
                    <span class="pink-dim" data-aos="fade-down" data-aos-delay="540" data-aos-duration="800">MEDIA</span>
                </h2>
                <p class="description" data-aos="fade-right" data-aos-delay="550" data-aos-duration="600">
                    Crafting the digital voice of Triverse — one post, reel, and story at a time.
                </p>
            </div>

            <!-- Member Grid with Path -->
            <div class="members-area">
                <!-- Desktop Curved Connecting Path (SVG) -->
                <svg class="connecting-path desktop-path" viewBox="0 0 600 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M0,100 Q150,40 300,100 T600,100"
                        stroke="rgba(236, 72, 153, 0.3)"
                        stroke-width="3"
                        stroke-dasharray="12 8"
                    />
                </svg>

                <!-- Mobile Zig-Zag Connecting Path (SVG) -->
                <svg class="connecting-path mobile-path" viewBox="0 0 200 500" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M60,80 L140,220 L60,370"
                        stroke="rgba(236, 72, 153, 0.4)"
                        stroke-width="2"
                    />
                </svg>

                <div class="members-grid">
                    {socialMediaData.map((member, index) => (
                        <div class={`grid-item item-${index}`} data-aos="zoom-in" data-aos-delay={(index * 150) + 400} data-aos-duration="600">
                            <MultimediaCard
                                name={member.name}
                                role={member.role}
                                image={member.image}
                                glowColor={member.glowColor}
                                index={index}
                            />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .socialmedia-section {
        padding: 10rem 2rem;
        background-color: #000;
        position: relative;
        overflow: hidden;
    }

    /* Subtle pink ambient glow */
    .socialmedia-section::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60vw;
        height: 60vh;
        background: radial-gradient(circle, rgba(236, 72, 153, 0.06) 0%, transparent 70%);
        pointer-events: none;
        filter: blur(80px);
        z-index: 0;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .section-layout {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 4rem;
        align-items: center;
    }

    .branding {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .title {
        display: flex;
        flex-direction: column;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 900;
        line-height: 0.9;
        letter-spacing: -0.05em;
        text-transform: uppercase;
    }

    .title .white    { color: white; }
    .title .pink     { color: #ec4899; }
    .title .pink-dim { color: rgba(236, 72, 153, 0.55); }

    .description {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        max-width: 300px;
        line-height: 1.6;
        font-weight: 500;
    }

    .members-area {
        position: relative;
        padding: 2rem 0;
    }

    .connecting-path {
        position: absolute;
        pointer-events: none;
        z-index: 1;
    }

    .desktop-path {
        top: 50%;
        left: 0;
        width: 100%;
        height: auto;
        transform: translateY(-50%);
    }

    .mobile-path {
        display: none;
    }

    .members-grid {
        display: grid;
        /* 3 members → 3 columns */
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        position: relative;
        z-index: 5;
    }

    @media (max-width: 1200px) {
        .section-layout {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .branding {
            align-items: center;
            margin-bottom: 4rem;
        }
        .description {
            max-width: 500px;
        }
    }

    @media (max-width: 768px) {
        .socialmedia-section { padding: 5rem 1.25rem; }

        .desktop-path { display: none; }
        .mobile-path {
            display: block;
            top: 80px;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            height: calc(100% - 80px);
            opacity: 0.5;
        }

        .members-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem 1rem;
            max-width: 420px;
            margin: 0 auto;
        }

        /* Lead spans full width, then two below */
        .item-0 { grid-column: 1 / -1; display: flex; justify-content: center; }
        .item-1, .item-2 { grid-column: auto; margin-top: 0; }

        .grid-item {
            display: flex;
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .members-grid { gap: 1.5rem 0.75rem; }
    }
</style>
