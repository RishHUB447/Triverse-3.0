<div class="ticker-wrap" data-aos="fade-in" data-aos-duration="1000">
    <div class="ticker">
        <div class="ticker__item">DEVANSH &ndash; </div>
        <div class="ticker__item">SATVIK &ndash; </div>
        <div class="ticker__item">RISHABH &ndash; </div>
        <div class="ticker__item">GAURIKA &ndash; </div>
        <div class="ticker__item">SAHARSH &ndash; </div>
    </div>
</div>

<style>
    .ticker-wrap {
        width: 100%;
        overflow: hidden;
        background-color: transparent;
        padding: 2.5rem 0;
        margin-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        position: relative;
        z-index: 1;
    }

    .ticker {
        display: flex;
        white-space: nowrap;
        animation: ticker 30s linear infinite;
    }

    .ticker__item {
        flex-shrink: 0;
        padding: 0 4rem;
        font-size: 3.5rem;
        font-weight: 900;
        color: white;
        text-transform: uppercase;
        letter-spacing: -0.02em;
    }

    @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    @media (max-width: 768px) {
        .ticker__item {
            font-size: 2rem;
            padding: 0 2rem;
        }
    }
</style>
