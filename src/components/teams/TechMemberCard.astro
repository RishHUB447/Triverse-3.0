---
interface Props {
    name: string;
    role: string;
    image: string;
    tickerText?: string;
    index: number;
}

const { name, role, image, index } = Astro.props;
const aosType = index % 2 === 0 ? "split-center-h" : "split-center-v";
---

<div class="tech-card">
    <div class="card-content">
        <div class="photo-side" data-aos={aosType} data-aos-duration="1200" data-aos-offset="0">
            <img src={image} alt={name} class="tech-photo" />
        </div>

        <div class="text-side">
            <h3 class="member-name">{name}</h3>
            <span class="member-role">{role}</span>
            <div class="member-dots">
                <span class="dot teal"></span>
                <span class="dot purple"></span>
                <span class="dot gray"></span>
            </div>
        </div>
    </div>
</div>

<style>
    .tech-card {
        padding: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        color: white;
        font-family: var(--font-sf-pro), sans-serif;
    }

    .card-content {
        display: grid;
        grid-template-columns: 180px 1fr; /* Fixed photo width as per mockup */
        gap: 2.5rem;
        align-items: center;
    }

    .photo-side {
        width: 100%;
        aspect-ratio: 1/1;
        overflow: hidden;
        filter: grayscale(1);
        transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1), -webkit-clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease !important;
    }

    .tech-card:hover .photo-side {
        filter: grayscale(0);
    }

    .tech-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .text-side {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .member-name {
        font-size: clamp(1.4rem, 2.5vw, 2.2rem);
        font-weight: 900;
        margin: 0;
        letter-spacing: -0.04em;
        text-transform: uppercase;
        line-height: 0.9;
        color: white;
    }

    .member-role {
        font-size: 0.75rem;
        color: #bfa181; /* Gold/Tan text from mockup */
        font-weight: 700;
        margin: 0.6rem 0 1.2rem;
        letter-spacing: 0.1rem;
        text-transform: uppercase;
        opacity: 0.9;
    }

    .member-dots {
        display: flex;
        gap: 0.6rem;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .dot.teal {
        background-color: #00f5d4;
    }
    .dot.purple {
        background-color: #a855f7;
    }
    .dot.gray {
        background-color: #222;
    }

    @media (max-width: 1200px) {
        .card-content {
            grid-template-columns: 140px 1fr;
            gap: 1.5rem;
        }
        .member-name {
            font-size: 2rem;
        }
    }

    @media (max-width: 768px) {
        .card-content {
            grid-template-columns: 120px 1fr;
        }
    }
</style>
