---
import "../assets/fonts.css";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Triverse-3.0", description = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/Tri.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- GSAP Core & ScrollTrigger -->
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
      defer></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"
      defer></script>

    <!-- ScrollSmoother (desktop only – guarded in JS) -->
    <script src="https://assets.codepen.io/16327/ScrollSmoother.min.js" defer
    ></script>

    <!-- Lenis fallback -->
    <script
      src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"
      defer></script>

    <!-- AOS CSS & JS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #000;
        font-family: var(--font-sf-pro), sans-serif;
      }

      /* ===== DESKTOP SMOOTH SCROLL SETUP ===== */
      #smooth-wrapper {
        overflow: hidden;
        position: relative;
        width: 100%;
        z-index: 2;
        pointer-events: none;
      }

      .content-wrapper {
        position: relative;
        z-index: 3;
        width: 100%;
        will-change: transform;
        pointer-events: auto;
      }

      #fixed-video-container {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
      }

      /* ===== MOBILE OVERRIDES (CRITICAL) ===== */
      @media (max-width: 768px) {
        #smooth-wrapper {
          overflow: visible !important;
          pointer-events: auto !important;
        }

        #smooth-content {
          transform: none !important;
        }

        .footer {
          position: relative !important;
        }
      }

      /* ===== GLOBAL GRAIN OVERLAY ===== */
      .grain-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 9999;
        opacity: 0.035; /* ultra-subtle */
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      }
      /* ===== AOS CUSTOM CLIP-PATH ANIMATIONS ===== */
      [data-aos="split-center-h"] {
        clip-path: inset(0% 50%);
        -webkit-clip-path: inset(0% 50%);
        transition-property:
          clip-path,
          -webkit-clip-path,
          transform,
          filter !important;
      }
      [data-aos="split-center-h"].aos-animate {
        clip-path: inset(0% 0%);
        -webkit-clip-path: inset(0% 0%);
      }

      [data-aos="split-center-v"] {
        clip-path: inset(50% 0%);
        -webkit-clip-path: inset(50% 0%);
        transition-property:
          clip-path,
          -webkit-clip-path,
          transform,
          filter !important;
      }
      [data-aos="split-center-v"].aos-animate {
        clip-path: inset(0% 0%);
        -webkit-clip-path: inset(0% 0%);
      }

      [data-aos="reveal-top"] {
        clip-path: inset(0% 0% 100% 0%);
        -webkit-clip-path: inset(0% 0% 100% 0%);
        transition-property:
          clip-path,
          -webkit-clip-path,
          transform,
          filter !important;
      }
      [data-aos="reveal-top"].aos-animate {
        clip-path: inset(0% 0% 0% 0%);
        -webkit-clip-path: inset(0% 0% 0% 0%);
      }

      [data-aos="reveal-bottom"] {
        clip-path: inset(100% 0% 0% 0%);
        -webkit-clip-path: inset(100% 0% 0% 0%);
        transition-property:
          clip-path,
          -webkit-clip-path,
          transform,
          filter !important;
      }
      [data-aos="reveal-bottom"].aos-animate {
        clip-path: inset(0% 0% 0% 0%);
        -webkit-clip-path: inset(0% 0% 0% 0%);
      }
    </style>
  </head>

  <body>
    <!-- Subtle Global Texture -->
    <div class="grain-overlay"></div>
    <Menu />

    <div id="fixed-video-container"></div>

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <div class="content-wrapper">
          <slot />
        </div>
        <Footer />
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        let currentIsMobile = window.innerWidth <= 768;
        let scrollSmoother = null;
        let lenis = null;
        let scrollTriggers = [];

        const check = setInterval(() => {
          if (window.gsap && window.ScrollTrigger && window.AOS) {
            clearInterval(check);
            init();
          }
        }, 100);

        function cleanup() {
          // Clean up ScrollTriggers
          scrollTriggers.forEach((st) => st.kill());
          scrollTriggers = [];
          ScrollTrigger.getAll().forEach((st) => st.kill());

          // Clean up ScrollSmoother
          if (scrollSmoother) {
            scrollSmoother.kill();
            scrollSmoother = null;
          }

          // Clean up Lenis
          if (lenis) {
            lenis.destroy();
            lenis = null;
          }
        }

        function init() {
          cleanup();

          const isMobile = window.innerWidth <= 768;
          gsap.registerPlugin(ScrollTrigger);

          if (window.AOS) {
            AOS.init({
              once: false, // Ensures reverse animations trigger on scroll up
              mirror: true, // Whether elements should animate out while scrolling past them
              duration: 800,
              offset: 100,
              anchorPlacement: "center-bottom", // Ensures element is half-visible before triggering
            });
            // Update AOS after ScrollTrigger initializes and Lenis ticks to prevent layout bugs
            setTimeout(() => {
              AOS.refresh();
            }, 500);
          }

          if (!isMobile && window.ScrollSmoother) {
            scrollSmoother = ScrollSmoother.create({
              wrapper: "#smooth-wrapper",
              content: "#smooth-content",
              smooth: 3,
              effects: true,
              normalizeScroll: true,
            });
          } else if (!window.ScrollSmoother && !isMobile) {
            initLenis();
          }

          if (!isMobile) {
            initParallax();
          }

          // Initializing independent GSAP scroll effects
          initCardSplits();

          // Refresh triggers safely to prevent misaligned clipping
          setTimeout(() => {
            ScrollTrigger.refresh();
          }, 600);
        }

        function initCardSplits() {
          const splitImages = document.querySelectorAll(
            ".leads-section .image-wrapper, .tech-section .photo-side",
          );
          splitImages.forEach((img) => {
            // Using fromTo for fallback safety and cross-browser webkit support
            gsap.fromTo(
              img,
              { clipPath: "inset(0% 50%)", webkitClipPath: "inset(0% 50%)" },
              {
                clipPath: "inset(0% 0%)",
                webkitClipPath: "inset(0% 0%)",
                duration: 1.2,
                ease: "power3.inOut",
                scrollTrigger: {
                  trigger: img,
                  start: "top 85%",
                  toggleActions: "play reverse play reverse",
                },
              },
            );
          });
        }

        function initLenis() {
          if (!window.Lenis) return;

          lenis = new Lenis({
            duration: 1.5,
            smooth: true,
            smoothTouch: false,
          });

          function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);

          lenis.on("scroll", ScrollTrigger.update);
          gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
          });
          gsap.ticker.lagSmoothing(0);
        }

        function initParallax() {
          document.querySelectorAll("[data-scroll]").forEach((el) => {
            const speed = parseFloat(el.dataset.scrollSpeed) || 0.5;
            const st = gsap.to(el, {
              y: () => window.innerHeight * speed * 0.3,
              ease: "none",
              scrollTrigger: {
                trigger: el,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            }).scrollTrigger;

            if (st) scrollTriggers.push(st);
          });
        }

        // Handle viewport resize
        let resizeTimer;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            const newIsMobile = window.innerWidth <= 768;
            if (newIsMobile !== currentIsMobile) {
              currentIsMobile = newIsMobile;
              init(); // Reinitialize when switching between mobile/desktop
            }
          }, 250);
        });
      });
    </script>
  </body>
</html>
