---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/teams/HeroSection.astro";
import TeamTicker from "../components/teams/TeamTicker.astro";
import LeadsSection from "../components/teams/LeadsSection.astro";
import TechSection from "../components/teams/TechSection.astro";
import OperationalSection from "../components/teams/OperationalSection.astro";
import DesignSection from "../components/teams/DesignSection.astro";
import ContentSection from "../components/teams/ContentSection.astro";
import MultimediaSection from "../components/teams/MultimediaSection.astro";
import SocialMediaSection from "../components/teams/SocialMediaSection.astro";
import SponsorshipSection from "../components/teams/SponsorshipSection.astro";
---

<Layout title="Teams - Triverse">
    <main class="teams-page">
        <HeroSection />
        <LeadsSection />
        <TechSection />
        <OperationalSection />
        <DesignSection />
        <ContentSection />
        <MultimediaSection />
        <SocialMediaSection />
        <SponsorshipSection />
    </main>

    <style>
        .teams-page {
            background-color: #000;
            color: white;
            min-height: 100vh;
            font-family: var(--font-sf-pro), sans-serif;
            overflow-x: hidden;
            position: relative;
        }

        /* Global Glow across the page */
        .teams-page::before {
            content: "";
            position: absolute;
            top: 10%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100vw;
            height: 100vh;
            background: radial-gradient(
                circle,
                rgba(138, 43, 226, 0.1) 0%,
                transparent 70%
            );
            pointer-events: none;
            z-index: 0;
            filter: blur(120px);
        }
    </style>
</Layout>
